<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>DLPBits</RootNamespace>
    <AssemblyName>DLPBits</AssemblyName>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <PropertyGroup>
    <AssemblyTitle>DLPBits</AssemblyTitle>
    <Description>Console application to program HP 8560E Spectrum Analyzer with DLPs from SDRAM dump image</Description>
    <Company>The Schnauzer Group</Company>
    <Product>DLPBits</Product>
    <Copyright>Copyright © Tony@schnauzedrgroup.com 2025</Copyright>
    <Version>1.0.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NationalInstruments.Visa" Version="25.5.0.13" />
    <PackageReference Include="Spectre.Console" Version="0.57.2" />
  </ItemGroup>

</Project>
